# FireCompass environment variables
# Copy to .env.local (never commit it) and fill in.

# OPTIONAL. Enables AI-written answers on /ask using Claude.
# Without it, /ask still works in "verified passages" mode (local retrieval with citations).
# Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# NASA PSI metadata is public and needs no key:
# https://psi.nasa.gov/geode-py/ws/repo/investigations/PSI-XX
